==================================================
HSRP GATEWAY REDUNDANCY LAB
COMPLETE CONFIGURATION
==================================================

TOPOLOGY:
GW1 ----
         ACCESS SWITCH ---- PC0
GW2 ----/                  PC1
                           PC2
                           PC3

NETWORK: 192.168.1.0/24

HSRP GROUP: 1
VIRTUAL IP: 192.168.1.3

==================================================
DEVICE 1: GW1 CONFIGURATION
==================================================

enable
configure terminal

hostname GW1

interface FastEthernet0/0
ip address 192.168.1.1 255.255.255.0
standby 1 ip 192.168.1.3
no shutdown
exit

end
write memory

==================================================
DEVICE 2: GW2 CONFIGURATION
==================================================

enable
configure terminal

hostname GW2

interface FastEthernet0/0
ip address 192.168.1.2 255.255.255.0
standby 1 ip 192.168.1.3
no shutdown
exit

! Configure Loopback Interface

interface Loopback0
ip address 8.8.8.8 255.255.255.255
exit

end
write memory

